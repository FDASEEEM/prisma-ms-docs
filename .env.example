NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
# Desactivar CORS en producción cuando API Gateway maneja CORS
ENABLE_CORS=true

DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Cognito JWKS — solo para validar JWT (jose)
# Los microservicios NO deben tener COGNITO_CLIENT_ID ni secretos.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# prisma-ms-users: el guard resuelve rol/colegioId del usuario contra este
# servicio (GET /api/auth/me) porque el access token de Cognito no trae custom:*.
USERS_SERVICE_URL=http://localhost:3001

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_FORCE_PATH_STYLE=false
S3_BUCKET=your-s3-bucket-name
PACI_DOCUMENTS_URL_EXPIRES_IN=900
JOB_UPLOAD_MAX_SIZE_MB=25

DYNAMO_TABLE=chat_sessions
CHAT_SESSION_DEFAULT_SCHOOL_ID=colegio_demo
AWS_DYNAMODB_ENDPOINT=
INTERNAL_TOKEN=your-internal-token
BD_LOGS=postgresql+asyncpg://user:password@host/database?ssl=require
